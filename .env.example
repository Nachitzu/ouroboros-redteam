# Required only for the LLM-assisted passes (the optional Static Analyzer
# enrichment and, from week 4, the Dynamic Attacker). The deterministic
# recon + static analysis run fully offline without it.
ANTHROPIC_API_KEY=

# Optional: a GitHub token (repo scope) lets the orchestrator resolve whether
# you have write access to a remote target. Leave it blank and Ouroboros will
# fail safe to AUDITOR mode, which never commits or opens PRs.
GITHUB_TOKEN=

# Optional overrides (see docs/architecture.md).
# OUROBOROS_MODEL=claude-sonnet-5
# OUROBOROS_DATA_DIR=./data
