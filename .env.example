# Provider API keys (only required for live --attack / --enrich passes).
# Deterministic recon, static analysis, and auditor-mode simulation run offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: a GitHub token (repo scope) lets the orchestrator confirm write
# access to a remote target. Leave blank to fail safe to AUDITOR mode.
GITHUB_TOKEN=

# Optional overrides (see docs/architecture.md and docs/datasets.md).
# OUROBOROS_MODEL=claude-sonnet-5
# OUROBOROS_DATA_DIR=./src/ouroboros/data
# OUROBOROS_PACKS_DIR=~/.ouroboros/packs
